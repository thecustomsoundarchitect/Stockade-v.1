{
  "name": "stockade-dashboard",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SNAPSHOTS", "class_name": "SnapshotStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SnapshotStore"] }]
}
